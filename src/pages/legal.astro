---
import Layout from '../layouts/Layout.astro';
import legalMd from '../config/legal.md?raw';
import { renderMarkdown } from '@astrojs/markdown-remark';

const { content } = await renderMarkdown(legalMd);
---

<Layout title="法律声明">
  <div class="min-h-[60vh] px-4 py-12">
    <div class="bg-white border-4 border-[#0284c7] p-8 sm:p-12 shadow-[8px_8px_0px_0px_#0284c7] rounded-sm max-w‑4xl w-full mx-auto animate-card-entrance">
      {content}
    </div>
  </div>
</Layout>
